<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="36dp">

            <!-- 品牌 Logo -->
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_logo_badge"
                android:contentDescription="@string/app_name"
                android:padding="16dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/setup_hero"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/setup_hero_desc"
                android:textColor="@color/on_surface_muted"
                android:textSize="14sp" />

            <!-- 进度步骤标签 -->
            <TextView
                android:id="@+id/setupStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 状态信息卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/setupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/setup_desc"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/setupProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/primary" />

            <Button
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button_primary"
                android:elevation="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/retry"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>